# ---------------------------------------------------------------------------
# AI Procurement Agent - environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
#
# Naming convention:
#   APP_*                    application behaviour (namespaced on purpose, so an
#                            ambient DEBUG/PORT in the host environment cannot
#                            silently reconfigure the service)
#   GOOGLE_API_KEY,          canonical provider credentials (unprefixed so that
#   TVLY_API_KEY, ...        existing provider tooling keeps working)
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="AI Procurement Agent"
APP_ENVIRONMENT=local             # local | development | staging | production | test
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_API_PREFIX=/api/v1
APP_CORS_ALLOW_ORIGINS=            # e.g. https://app.example.com,https://admin.example.com

# --- Logging ---------------------------------------------------------------
APP_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_FORMAT=console            # console | json

# --- Store / provider selection -------------------------------------------
APP_LLM_PROVIDER=gemini           # gemini | mock
APP_SEARCH_PROVIDER=tavily        # tavily | mock
APP_SCRAPER_PROVIDER=scrapegraph  # scrapegraph | mock
APP_REPORT_PROVIDER=jinja         # jinja | mock
APP_WORKFLOW=crew                 # crew | sequential (sequential = deterministic, no agent orchestration)

# --- Model configuration ---------------------------------------------------
# Never hardcode credentials in source code.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
APP_LLM_TEMPERATURE=0

# --- Search provider (Tavily) ---------------------------------------------
TVLY_API_KEY=
APP_SEARCH_MAX_RESULTS=10

# --- Scraping provider (ScrapeGraph) --------------------------------------
SCRAPEGRAPH_API_KEY=

# --- Observability (AgentOps, optional and fail-safe) ----------------------
APP_AGENTOPS_ENABLED=false
AGENTOPS_API_KEY=
APP_AGENTOPS_SKIP_AUTO_END_SESSION=true
APP_AGENTOPS_DEFAULT_TAGS=crewai,procurement

# CrewAI ships its own OTLP exporter which would duplicate AgentOps spans.
# Leave this false unless you intentionally want CrewAI-managed tracing.
APP_CREWAI_TRACING_ENABLED=false

# --- Reliability -----------------------------------------------------------
APP_REQUEST_TIMEOUT_SECONDS=30
APP_MAX_RETRIES=3
APP_RETRY_BACKOFF_SECONDS=0.5

# --- Persistence -----------------------------------------------------------
APP_PERSISTENCE_BACKEND=sqlite    # sqlite | memory
APP_SQLITE_PATH=data/procurement.db

# --- Reporting -------------------------------------------------------------
APP_REPORT_OUTPUT_DIR=ai-agent-output
APP_REPORT_TEMPLATE_DIR=templates
APP_REPORT_TEMPLATE=procurement_report.html
